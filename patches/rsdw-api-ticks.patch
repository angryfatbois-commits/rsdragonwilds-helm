diff --git a/tests/tick_metrics_test.cpp b/tests/tick_metrics_test.cpp
new file mode 100644
index 0000000..c6a18b9
--- /dev/null
+++ b/tests/tick_metrics_test.cpp
@@ -0,0 +1,224 @@
+#include "../src/engine/tick_metrics.cpp"
+#include "../src/api/system_routes.cpp"
+
+#include <cassert>
+#include <cmath>
+#include <iostream>
+#include <map>
+#include <thread>
+
+DomEngine::Engine* DomEngine::g_Engine = nullptr;
+static std::map<std::string, RouteHandler> handlers;
+HttpServer::HttpServer() = default;
+HttpServer::~HttpServer() = default;
+void HttpServer::Get(const std::string& path, RouteHandler handler) { handlers[path] = std::move(handler); }
+
+using namespace TickMetrics;
+constexpr int64_t ms = 1000000;
+constexpr int64_t unixMs = 1800000000000;
+
+static bool Is(const Snapshot& value, const char* status) {
+    return std::strcmp(value.status, status) == 0;
+}
+
+static History Fixture() {
+    History h;
+    assert(h.Append({900 * ms, 1000 * ms}, unixMs));
+    const int64_t durations[] = {1, 2, 3, 4, 100};
+    for (int i = 0; i < 5; ++i) {
+        const int64_t end = (1200 + i * 200) * ms;
+        assert(h.Append({end - durations[i] * ms, end}, unixMs + 200 + i * 200));
+    }
+    return h;
+}
+
+static void Windows() {
+    History h;
+    assert(Is(Summarize(h, kSecond), "warming"));
+    assert(h.Append({900 * ms, kSecond}, unixMs));
+    assert(Is(Summarize(h, kSecond), "warming"));
+    h = Fixture();
+    auto snapshot = Summarize(h, 2250 * ms);
+    assert(Is(snapshot, "ready"));
+    const auto& m = *snapshot.measurement;
+    assert(m.sampleCount == 5 && m.windowSeconds == 1 && m.rateHz == 5);
+    assert(m.p50Ms == 3 && m.p95Ms == 100 && m.p99Ms == 100);
+    assert(m.lastSampleAgeSeconds == 0.25 && m.observedAtUnixMs == unixMs + 1000);
+    assert(Is(Summarize(h, 4001 * ms), "stale"));
+    assert(Is(Summarize(h, 1999 * ms), "faulted"));
+    assert(!h.Append({1900 * ms, 2200 * ms}, unixMs));
+    assert(!h.Append({2300 * ms, 2200 * ms}, unixMs));
+    assert(!h.Append({2200 * ms, 2300 * ms}, 0));
+
+    assert(h.Append({2100 * ms, 14100 * ms}, unixMs + 13100));
+    snapshot = Summarize(h, 14100 * ms);
+    assert(Is(snapshot, "ready"));
+    assert(snapshot.measurement->sampleCount == 1);
+    assert(std::abs(snapshot.measurement->windowSeconds - 12.1) < 1e-9);
+    assert(std::abs(snapshot.measurement->rateHz - 1.0 / 12.1) < 1e-9);
+    assert(snapshot.measurement->p99Ms == 12000);
+
+    History wrap;
+    for (size_t i = 1; i <= kCapacity + 20; ++i) {
+        const int64_t end = static_cast<int64_t>(i) * 10 * ms;
+        assert(wrap.Append({end - ms, end}, unixMs + i * 10));
+    }
+    snapshot = Summarize(wrap, wrap.At(wrap.count - 1).end);
+    assert(Is(snapshot, "ready") && snapshot.measurement->sampleCount == 1000);
+    assert(snapshot.measurement->rateHz == 100 && snapshot.measurement->windowSeconds == 10);
+
+    History overflow;
+    for (size_t i = 1; i <= kCapacity + 20; ++i) {
+        const int64_t end = static_cast<int64_t>(i) * ms;
+        assert(overflow.Append({end - ms / 2, end}, unixMs + i));
+    }
+    assert(Is(Summarize(overflow, overflow.At(overflow.count - 1).end), "warming"));
+    assert(std::strcmp(Summarize(overflow, overflow.At(overflow.count - 1).end).reason, "window-overflow") == 0);
+    for (int i = 1; i <= 1100; ++i) {
+        const int64_t end = (static_cast<int64_t>(kCapacity + 20) + i * 10) * ms;
+        assert(overflow.Append({end - ms, end}, unixMs + end / ms));
+    }
+    assert(Is(Summarize(overflow, overflow.At(overflow.count - 1).end), "ready"));
+}
+
+static int calls;
+static void* seenEngine;
+static float seenDelta;
+static bool seenIdle;
+static void Original(void* engine, float delta, bool idle) {
+    ++calls;
+    seenEngine = engine;
+    seenDelta = delta;
+    seenIdle = idle;
+}
+static void Throwing(void* engine, float delta, bool idle) {
+    Original(engine, delta, idle);
+    throw 42;
+}
+static State* recursiveState;
+static void Recursive(void* engine, float delta, bool idle) {
+    Original(engine, delta, idle);
+    if (calls == 1) MeasureTick(*recursiveState, engine, delta, idle, engine, kAddressPoint);
+}
+
+static void Forwarding() {
+    State state;
+    int engine, other;
+    state.original = Original;
+    state.collecting = true;
+    calls = 0;
+    MeasureTick(state, &engine, 0.125f, true, &engine, kAddressPoint);
+    assert(calls == 1 && seenEngine == &engine && seenDelta == 0.125f && seenIdle);
+    assert(state.history.count == 1 && !state.active);
+    state.collecting = false;
+    MeasureTick(state, &engine, 0.25f, false, &engine, kAddressPoint);
+    assert(calls == 2 && state.history.count == 1 && seenDelta == 0.25f && !seenIdle);
+    state.collecting = true;
+    MeasureTick(state, &engine, 0.5f, true, &other, kAddressPoint);
+    assert(calls == 3 && !state.collecting && std::strcmp(state.status, "faulted") == 0);
+    assert(state.history.count == 1);
+
+    State throwing;
+    throwing.original = Throwing;
+    throwing.collecting = true;
+    bool propagated = false;
+    try { MeasureTick(throwing, &engine, 1, false, &engine, kAddressPoint); }
+    catch (int value) { propagated = value == 42; }
+    assert(propagated && !throwing.collecting && !throwing.active && !throwing.history.count);
+
+    State recursive;
+    recursive.original = Recursive;
+    recursive.collecting = true;
+    recursiveState = &recursive;
+    calls = 0;
+    MeasureTick(recursive, &engine, 1, true, &engine, kAddressPoint);
+    assert(calls == 2 && !recursive.collecting && !recursive.history.count && !recursive.active);
+
+    State thread;
+    thread.original = Original;
+    thread.collecting = true;
+    MeasureTick(thread, &engine, 1, false, &engine, kAddressPoint);
+    std::thread foreign([&] { MeasureTick(thread, &engine, 1, false, &engine, kAddressPoint); });
+    foreign.join();
+    assert(!thread.collecting && thread.history.count == 1);
+}
+
+static void ProfileAndPublication() {
+    uint8_t notes[24] = {4, 0, 0, 0, 8, 0, 0, 0, 3, 0, 0, 0, 'G', 'N', 'U', 0};
+    std::memcpy(notes + 16, kBuildId, sizeof(kBuildId));
+    unsigned matches = 0;
+    assert(BuildNotesMatch(notes, sizeof(notes), matches) && matches == 1);
+    matches = 0;
+    assert(!BuildNotesMatch(notes, 23, matches));
+    notes[4] = 9;
+    assert(!BuildNotesMatch(notes, sizeof(notes), matches));
+    notes[4] = 8;
+    notes[16] ^= 1;
+    assert(!BuildNotesMatch(notes, sizeof(notes), matches));
+    notes[0] = 255;
+    assert(!BuildNotesMatch(notes, sizeof(notes), matches));
+    InstallBeforeMain();
+    assert(Is(Read(), "unsupported") && Storage()->original == nullptr);
+    InstallBeforeMain();
+    assert(Is(Read(), "unsupported"));
+    StopCollecting();
+    StopCollecting();
+    InstallBeforeMain();
+    assert(Is(Read(), "stopped") && Storage()->original == nullptr);
+}
+
+static void ConcurrentReadsAndStop() {
+    State& state = *Storage();
+    {
+        std::lock_guard<std::mutex> lock(state.mutex);
+        state.history = {};
+        state.collecting = true;
+    }
+    std::thread writer([&] {
+        for (int i = 0; i < 2000; ++i) {
+            const int64_t end = Now(CLOCK_MONOTONIC);
+            std::lock_guard<std::mutex> lock(state.mutex);
+            if (state.collecting) assert(state.history.Append({end, end}, unixMs + i));
+        }
+    });
+    for (int i = 0; i < 200; ++i) {
+        const auto result = Read();
+        assert(Is(result, "warming") || Is(result, "ready"));
+    }
+    StopCollecting();
+    writer.join();
+    assert(Is(Read(), "stopped"));
+}
+
+static void Schema() {
+    const auto snapshot = Summarize(Fixture(), 2250 * ms);
+    const std::string prefix = "{\"schemaVersion\":1,\"tick\":{";
+    const auto response = ApiRoutes::MetricsResponse(snapshot, true);
+    assert(response.status == 200 && response.contentType == "application/json");
+    assert(response.body == prefix +
+        "\"status\":\"ready\",\"source\":\"engine_tick_hook\",\"scope\":\"UDomGameEngine::Tick\",\"reason\":\"\","
+        "\"windowSeconds\":1,\"sampleCount\":5,\"lastSampleAgeSeconds\":0.25,\"observedAtUnixMs\":1800000001000,"
+        "\"rateHz\":5,\"executionMs\":{\"p50\":3,\"p95\":100,\"p99\":100}}}");
+    const std::string nulls = "\"windowSeconds\":null,\"sampleCount\":null,\"lastSampleAgeSeconds\":null,"
+        "\"observedAtUnixMs\":null,\"rateHz\":null,\"executionMs\":{\"p50\":null,\"p95\":null,\"p99\":null}}}";
+    const auto starting = ApiRoutes::MetricsResponse(snapshot, false);
+    assert(starting.body.find("\"status\":\"starting\"") != std::string::npos);
+    assert(starting.body.find(nulls) != std::string::npos);
+    for (const char* status : {"warming", "unsupported", "faulted", "stale", "stopped"}) {
+        const auto unavailable = ApiRoutes::MetricsResponse({status, "test", {}}, true);
+        assert(unavailable.body.find(nulls) != std::string::npos);
+    }
+    HttpServer server;
+    ApiRoutes::RegisterSystem(server);
+    assert(handlers.count("/api/metrics") == 1);
+    assert(handlers.at("/api/metrics")({}).body.find(nulls) != std::string::npos);
+}
+
+int main() {
+    Windows();
+    Forwarding();
+    ProfileAndPublication();
+    ConcurrentReadsAndStop();
+    Schema();
+    std::cout << "PASS tick windows, long ticks, overflow recovery, forwarding, unwind, profile rejection, concurrency, schema\n";
+}
