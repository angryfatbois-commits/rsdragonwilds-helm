{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "server",
    "config",
    "persistence",
    "saveSeed",
    "api",
    "metrics",
    "service",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "imagePullSecrets",
    "podAnnotations",
    "podLabels",
    "securityContext",
    "containerSecurityContext"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "env",
        "extraEnv"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              },
              "valueFrom": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedicatedServerIni"
      ],
      "properties": {
        "dedicatedServerIni": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "accessModes",
        "retain"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany"
            ]
          }
        },
        "retain": {
          "type": "boolean"
        }
      }
    },
    "saveSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "path"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^$|^[^/].*\\.sav$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port",
        "bearerTokenSecret",
        "logging"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bearerTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "verbose"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "verbose": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "serviceMonitor",
        "networkPolicy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "interval",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "allowedPeers"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedPeers": {
              "type": "array",
              "items": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    }
  }
}
